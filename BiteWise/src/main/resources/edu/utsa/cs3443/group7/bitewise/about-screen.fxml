<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="680.0" prefWidth="462.0" style="-fx-padding: 20;" styleClass="screen-shell" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AboutController">

    <children>
        <!-- Back Button -->
        <Button ellipsisString="←" layoutX="25.0" layoutY="25.0" onAction="#handleBackToSettings" prefHeight="45.0" prefWidth="47.0" style="-fx-background-color: #BDE070; -fx-text-fill: #53382E; -fx-font-weight: bold;                        -fx-background-radius: 50; -fx-border-color: #53382E;                        -fx-border-width: 2; -fx-border-radius: 50;" text="←">
            <font>
                <Font name="KG Red Hands" size="20.0" />
            </font>
        </Button>

        <!-- Logo -->
        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="130.0" layoutY="48.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@ui_icons/logo.png" />
            </image>
        </ImageView>

        <!-- App Title -->
        <Text fill="#CBE985" layoutX="121.0" layoutY="212.0" stroke="#53382E" strokeLineJoin="ROUND" strokeType="OUTSIDE" strokeWidth="2.3" text="BiteWise">
            <font>
                <Font name="KG Red Hands" size="48.0" />
            </font>
            <smooth>true</smooth>
        </Text>


        <!-- About Heading -->
        <Label layoutX="171.0" layoutY="251.0" text="About" textFill="#53382E">
            <font>
                <Font name="KG Red Hands" size="35.0" />
            </font>
        </Label>

        <!-- Description -->
        <Text fill="#53382E" layoutX="59.0" layoutY="335.0" text="BiteWise estimates the calories in a meal based on photos of food using AI image recognition." wrappingWidth="345.0">
            <font>
                <Font name="KG Red Hands" size="18.0" />
            </font>
        </Text>

        <!-- Subheading -->
        <Label layoutX="92.0" layoutY="405.0" text="For best results.." textFill="#53382E">
            <font>
                <Font name="KG Red Hands" size="30.0" />
            </font>
        </Label>

        <!-- Bullet points -->
        <Text fill="#53382E" layoutX="101.0" layoutY="484.0" text="• Take photos from above • Ensure good lighting        • Avoid blurriness" wrappingWidth="262.0">
            <font>
                <Font name="KG Red Hands" size="18.0" />
            </font>
        </Text>

        <!-- Get Started button -->
        <Button layoutX="140.0" layoutY="575.0" onAction="#handleGetStarted" prefHeight="50.0" prefWidth="180.0" style="-fx-background-color: #A8C474; -fx-text-fill: white; -fx-font-weight: bold;                        -fx-background-radius: 25; -fx-border-color: #53382E;                        -fx-border-width: 2; -fx-border-radius: 25;" text="Get Started">
            <font>
                <Font name="KG Red Hands" size="18.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
