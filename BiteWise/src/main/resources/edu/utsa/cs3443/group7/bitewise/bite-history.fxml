<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="680.0" prefWidth="462.0" style="-fx-background-color: #FAF0E6; -fx-padding: 20;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BiteHistoryController">

    <!-- Logo -->
    <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="133.0" layoutY="33.0" pickOnBounds="true" preserveRatio="true">
        <Image url="@ui_icons/logo.png" />
    </ImageView>

    <!-- BiteWise Title (outlined) -->
    <Label layoutX="118.0" layoutY="143.0" styleClass="str" text="BiteWise">
        <font>
            <Font name="KG Red Hands" size="48.0" />
        </font>
    </Label>

    <!-- Subheading -->
    <Label layoutX="133.0" layoutY="220.0" styleClass="slogan" text="Bite History" textFill="#53382E">
        <font>
            <Font name="KG Red Hands" size="30.0" />
        </font>
    </Label>

    <!-- Scrollable Bite Entries -->
    <ScrollPane fitToWidth="true" layoutX="48.0" layoutY="272.0" prefHeight="320.0" prefWidth="362.0" style="-fx-background: #FAF0E6; -fx-background-color: #FAF0E6; -fx-border-color: transparent;">

        <content>
            <VBox spacing="18" style="-fx-background-color: transparent;">

                <!-- Entry 1 -->
                <VBox spacing="8" styleClass="bite-history-element">
                    <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>
                    <Label styleClass="bite-history-element-title" text="Bite 1">
                        <font><Font name="KG Red Hands" size="16" /></font>
                    </Label>
                    <Label text="• Scrambled eggs" />
                    <Label styleClass="bite-history-info" text="Calories: 450" />
                </VBox>

                <!-- Entry 2 -->
                <VBox spacing="8" styleClass="bite-history-element">
                    <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>
                    <Label styleClass="bite-history-element-title" text="Bite 2">
                        <font><Font name="KG Red Hands" size="16" /></font>
                    </Label>
                    <Label text="• Whole grain bread" />
                    <Label styleClass="bite-history-info" text="Calories: 620" />
                </VBox>

                <!-- Entry 3 -->
                <VBox spacing="8" styleClass="bite-history-element">
                    <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>
                    <Label styleClass="bite-history-element-title" text="Bite 3">
                        <font><Font name="KG Red Hands" size="16" /></font>
                    </Label>
                    <Label text="• Mashed potatoes" />
                    <Label styleClass="bite-history-info" text="Calories: 780" />
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- Back Button -->
    <Button fx:id="backButton" layoutX="190.0" layoutY="610.0" onAction="#handleBackClick" prefHeight="70.0" prefWidth="80.0" style="-fx-background-color: #A8C474; -fx-background-radius: 50;                    -fx-border-color: #53382E; -fx-border-radius: 50;                    -fx-font-weight: bold;" text="←">
        <font>
            <Font name="KG Red Hands" size="28.0" />
        </font>
    </Button>

</AnchorPane>
