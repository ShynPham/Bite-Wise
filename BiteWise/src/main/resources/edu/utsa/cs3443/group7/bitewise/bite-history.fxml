<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="740.0" prefWidth="462.0" style="-fx-font-family: 'KG Red Hands';" styleClass="screen-shell" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BiteHistoryController">

    <top>
        <VBox alignment="CENTER" spacing="5.0">
            <padding>
                <Insets bottom="12.0" left="26.0" right="26.0" top="20.0" />
            </padding>
            <ImageView fitHeight="105.0" fitWidth="154.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@ui_icons/logo.png" />
            </ImageView>
            <Label styleClass="screen-title" text="Bite History" />
            <Label styleClass="screen-kicker" text="Today's calories, saved bites, and snack ideas." />
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="8.0" left="26.0" right="26.0" top="0.0" />
            </padding>

            <HBox alignment="CENTER" spacing="9.0">
                <VBox alignment="CENTER" prefHeight="60.0" prefWidth="126.0" spacing="2.0" styleClass="summary-chip">
                    <Label styleClass="section-label" text="TODAY" />
                    <Label fx:id="totalCaloriesLabel" styleClass="metric-number" text="0 kcal" />
                </VBox>
                <VBox alignment="CENTER" prefHeight="60.0" prefWidth="126.0" spacing="2.0" styleClass="summary-chip">
                    <Label styleClass="section-label" text="LIMIT" />
                    <Label fx:id="calorieLimitLabel" styleClass="metric-number" text="2000 kcal" />
                </VBox>
                <Button fx:id="changeLimitButton" onAction="#onChangeLimitClick" prefHeight="60.0" prefWidth="116.0" styleClass="ghost-button" text="Change" />
            </HBox>

            <VBox spacing="7.0" styleClass="progress-card">
                <padding>
                    <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                </padding>
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="section-label" text="DAILY PROGRESS" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="progressPercentLabel" styleClass="metric-number" text="0%" />
                </HBox>
                <ProgressBar fx:id="calorieProgressBar" prefHeight="18.0" prefWidth="382.0" progress="0.0" />
            </VBox>

            <SplitPane dividerPositions="0.58" orientation="VERTICAL" prefHeight="258.0" prefWidth="410.0" styleClass="big-card" VBox.vgrow="ALWAYS">
                <ListView fx:id="historyListView" prefHeight="148.0" prefWidth="400.0" />
                <TextArea fx:id="detailsTextArea" editable="false" prefHeight="110.0" prefWidth="400.0" promptText="Select a bite to see nutrition details." styleClass="details-area" wrapText="true" />
            </SplitPane>

            <VBox alignment="CENTER" spacing="4.0" styleClass="status-card">
                <padding>
                    <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                </padding>
                <Label styleClass="section-label" text="SUGGESTION" />
                <Label fx:id="recommendationLabel" styleClass="metric-number" text="..." textAlignment="CENTER" wrapText="true" />
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="12.0">
            <padding>
                <Insets bottom="22.0" left="26.0" right="26.0" top="10.0" />
            </padding>
            <Button fx:id="backButton" onAction="#handleBackClick" prefHeight="50.0" prefWidth="96.0" styleClass="ghost-button" text="Back" />
            <Button fx:id="deleteButton" onAction="#onDeleteClick" prefHeight="50.0" prefWidth="195.0" styleClass="danger-button" text="Delete Selected" />
        </HBox>
    </bottom>
</BorderPane>
