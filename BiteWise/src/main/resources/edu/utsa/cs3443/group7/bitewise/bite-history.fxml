<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="680.0" prefWidth="462.0" style="-fx-background-color: #FAF0E6; -fx-padding: 20;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BiteHistoryController">

    <!-- Logo -->
    <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="133.0" layoutY="11.0" pickOnBounds="true" preserveRatio="true">
        <Image url="@ui_icons/logo.png" />
    </ImageView>

    <!-- BiteWise Title (outlined) -->
    <Label layoutX="118.0" layoutY="125.0" styleClass="str" text="BiteWise">
        <font>
            <Font name="KG Red Hands" size="48.0" />
        </font>
    </Label>

    <!-- Subheading -->
    <Label layoutX="133.0" layoutY="200.0" styleClass="slogan" text="Bite History" textFill="#53382E">
        <font>
            <Font name="KG Red Hands" size="30.0" />
        </font>
    </Label>

    <!-- Splitpanel Bite Entries -->
    <SplitPane dividerPositions="0.6" layoutX="40.0" layoutY="272.0" orientation="VERTICAL" prefHeight="320.0" prefWidth="382.0" style="-fx-border-color: #a8c474; -fx-border-width: 2;">
        <ListView fx:id="historyListView" prefHeight="200.0" prefWidth="200.0" />

        <TextArea fx:id="detailsTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" style="-fx-font-family: 'Arial'; -fx-font-size: 14px;" wrapText="true" />
    </SplitPane>

    <!-- Back Button -->
    <HBox alignment="CENTER" layoutX="40.0" layoutY="610.0" spacing="20.0">
        <Button fx:id="backButton" onAction="#handleBackClick" prefHeight="70.0" prefWidth="80.0" text="←">
         <styleClass>
            <String fx:value="bite-history-element" />
            <String fx:value="str" />
         </styleClass></Button>

        <Button fx:id="deleteButton" onAction="#onDeleteClick" prefHeight="70.0" prefWidth="200.0" styleClass="bite-history-element-title" text="Deleted" />
    </HBox>

    <HBox alignment="CENTER_LEFT" layoutX="49.0" layoutY="247.0" prefWidth="362.0" spacing="10.0">
        <children>
            <Label styleClass="slogan" text="Today's Total:" />
            <Label fx:id="totalCaloriesLabel" styleClass="bite-history-info" text="0 kcal" />
            <Region HBox.hgrow="ALWAYS" /> <Label styleClass="slogan" text="Limit:" />
            <Label fx:id="calorieLimitLabel" styleClass="slogan" text="2000 kcal" />
            <Button fx:id="changeLimitButton" onAction="#onChangeLimitClick" styleClass="settings-button-white" text="Change">
            <font>
               <Font name="Arial" size="12.0" />
            </font></Button>
        </children>
    </HBox>

</AnchorPane>
