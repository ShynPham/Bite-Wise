<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1143.0" style="-fx-background-color: #FAF0E6; -fx-padding: 20;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ForgotPasswordController">

    <!-- Logo -->
    <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="474.0" layoutY="104.0" pickOnBounds="true" preserveRatio="true">
        <Image url="@ui_icons/logo.png" />
    </ImageView>

    <!-- App Title -->
    <Label layoutX="463.0" layoutY="213.0" styleClass="str" text="BiteWise" textFill="#bde070">
        <font>
            <Font name="KG Red Hands" size="48.0" />
        </font>
    </Label>

    <!-- Slogan -->
    <Label layoutX="467.0" layoutY="279.0" styleClass="slogan" text="Snap a bite, see the count" textFill="#53382e">
        <font>
            <Font name="KG Red Hands" size="15.0" />
        </font>
    </Label>

    <!-- Forgot Password Heading -->
    <Label layoutX="409.0" layoutY="333.0" prefHeight="66.0" prefWidth="332.0" styleClass="slogan" text="Forgot Password" textAlignment="CENTER" textFill="#53382e">
        <font>
            <Font name="KG Red Hands" size="35.0" />
        </font>
    </Label>

    <!-- Email Input -->
    <TextField fx:id="emailField" layoutX="449.0" layoutY="409.0" prefHeight="41.0" prefWidth="253.0" promptText="Your Email" styleClass="textbox">
        <font>
            <Font name="KG Red Hands" size="15.0" />
        </font>
    </TextField>

    <!-- New Password Input -->
    <PasswordField fx:id="newPasswordField" layoutX="449.0" layoutY="460.0" prefHeight="41.0" prefWidth="253.0" promptText="New Password" styleClass="textbox">
        <font>
            <Font name="KG Red Hands" size="15.0" />
        </font>
    </PasswordField>

    <!-- Continue / Reset Button -->
    <Button fx:id="resetButton" layoutX="524.0" layoutY="546.0" mnemonicParsing="false" onAction="#handleResetPassword" prefHeight="100.0" prefWidth="100.0" style="-fx-border-radius: 50;" styleClass="circle-button" stylesheets="@style.css">
        <graphic>
            <SVGPath content="M 0 0 L 10 5 L 0 10 L 0 6 L -10 6 L -10 4 L 0 4 Z" styleClass="svg-path" />
        </graphic>
    </Button>

    <!-- Sign In Redirect -->
    <HBox alignment="CENTER" layoutX="322.0" layoutY="646.0" prefWidth="500.0" spacing="5.0">
        <Label styleClass="slogan" text="Remembered your password?" textFill="#53382e">
            <font>
                <Font name="KG Red Hands" size="14.0" />
            </font>
        </Label>
        <Hyperlink fx:id="onSignInClick" onAction="#handleSignInLinkClick" text="SIGN IN" textFill="#53382e" underline="true">
            <font>
                <Font name="KG Red Hands" size="14.0" />
            </font>
        </Hyperlink>
    </HBox>

</AnchorPane>
