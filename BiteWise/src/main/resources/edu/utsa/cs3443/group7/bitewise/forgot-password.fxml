<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="680.0" prefWidth="462.0" style="-fx-background-color: #D4EAD0;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ForgotPasswordController">

    <VBox alignment="CENTER" spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="40" top="40" />
        </padding>

        <!-- Logo -->
        <ImageView fitHeight="180.0" fitWidth="220.0" preserveRatio="true">
            <Image url="@ui_icons/logo.png" />
        </ImageView>

        <!-- App Name -->
        <Label prefHeight="99.0" prefWidth="452.0" text="  BiteWise" textFill="#53382E">
            <font>
                <Font name="KG Red Hands" size="72.0" />
            </font>
        </Label>

        <!-- Tagline -->
        <Label text="Snap a bite, see the count" textFill="#53382E">
            <font>
                <Font name="KG Red Hands" size="22.0" />
            </font>
        </Label>

        <!-- Section Title -->
        <Label style="-fx-font-weight: bold;" text="Forgot password" textFill="#53382E">
            <font>
                <Font name="KG Red Hands" size="36.0" />
            </font>
        </Label>

        <!-- Input Fields -->
        <VBox alignment="CENTER" fillWidth="false" prefHeight="104.0" prefWidth="1326.0" spacing="14.0">
            <TextField fx:id="emailField" prefHeight="45.0" prefWidth="350.0" promptText="Your Email" style="-fx-background-color: #FFF0EA; -fx-background-radius: 20; -fx-border-color: #53382E; -fx-border-radius: 20;">
                <font>
                    <Font name="KG Red Hands" size="18.0" />
                </font>
            </TextField>

            <PasswordField fx:id="newPasswordField" prefHeight="45.0" prefWidth="350.0" promptText="New password" style="-fx-background-color: #FFF0EA; -fx-background-radius: 20; -fx-border-color: #53382E; -fx-border-radius: 20;">
                <font>
                    <Font name="KG Red Hands" size="18.0" />
                </font>
            </PasswordField>
        </VBox>

        <!-- Sign Up link -->
        <Hyperlink fx:id="signupLink" text="Sign Up" textFill="#53382E">
            <font>
                <Font name="KG Red Hands" size="18.0" />
            </font>
        </Hyperlink>
        <Button fx:id="submitButton" layoutX="183.0" layoutY="500.0" mnemonicParsing="false" onAction="#handleResetPasswordClick" prefHeight="86.0" prefWidth="57.0" style="-fx-border-radius: 50;" styleClass="circle-button" stylesheets="@style.css">
            <graphic>
                <SVGPath content="M 0 0 L 10 5 L 0 10 L 0 6 L -10 6 L -10 4 L 0 4 Z" styleClass="svg-path" />
            </graphic>
        </Button>
    </VBox>
</AnchorPane>
