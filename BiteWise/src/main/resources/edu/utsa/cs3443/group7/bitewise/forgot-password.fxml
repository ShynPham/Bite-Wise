<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="1024.0" prefWidth="1440.0"
            style="-fx-background-color: #D4EAD0;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ForgotPasswordController">

    <children>
        <VBox alignment="CENTER" spacing="18.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0">

            <!-- Logo -->
            <ImageView fitHeight="180.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@ui_icons/logo.png" />
                </image>
            </ImageView>

            <!-- Title -->
            <Label text="BiteWise" textFill="#53382E" alignment="CENTER">
                <font>
                    <Font name="KG Red Hands" size="72.0" />
                </font>
            </Label>

            <!-- Tagline -->
            <Label text="Snap a bite, see the count" textFill="#53382E" alignment="CENTER">
                <font>
                    <Font name="KG Red Hands" size="22.0" />
                </font>
            </Label>

            <!-- Reset Password Heading -->
            <Label text="Reset password" textFill="#53382E" alignment="CENTER" style="-fx-font-weight: bold;">
                <font>
                    <Font name="KG Red Hands" size="36.0" />
                </font>
            </Label>

            <!-- Input Fields -->
            <VBox alignment="CENTER" spacing="14.0">
                <TextField fx:id="emailField" promptText="Your Email"
                           prefWidth="350.0" prefHeight="45.0"
                           style="-fx-background-color: #FFF0EA; -fx-background-radius: 20; -fx-border-color: #53382E; -fx-border-radius: 20; -fx-text-fill: #53382E; -fx-font-size: 18px;">
                    <font>
                        <Font name="KG Red Hands" size="18.0" />
                    </font>
                </TextField>

                <PasswordField fx:id="newPasswordField" promptText="New password"
                               prefWidth="350.0" prefHeight="45.0"
                               style="-fx-background-color: #FFF0EA; -fx-background-radius: 20; -fx-border-color: #53382E; -fx-border-radius: 20; -fx-text-fill: #53382E; -fx-font-size: 18px;">
                    <font>
                        <Font name="KG Red Hands" size="18.0" />
                    </font>
                </PasswordField>
            </VBox>

            <!-- Sign Up Link -->
            <Hyperlink fx:id="signupLink" text="Sign Up" textFill="#53382E" underline="true">
                <font>
                    <Font name="KG Red Hands" size="18.0" />
                </font>
            </Hyperlink>

            <!-- Submit Button (→) -->
            <Button fx:id="submitButton"
                    text="→"
                    prefWidth="60.0" prefHeight="60.0"
                    style="-fx-background-color: #A8C474; -fx-background-radius: 50; -fx-border-color: #53382E; -fx-border-radius: 50; -fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;">
                <font>
                    <Font name="KG Red Hands" size="28.0" />
                </font>
            </Button>
        </VBox>
    </children>
</AnchorPane>