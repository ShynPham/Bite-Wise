<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="730.0" prefWidth="1080.0" style="-fx-font-family: 'KG Red Hands';" styleClass="screen-shell" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GoalsController">
    <top>
        <VBox spacing="8" styleClass="hero-strip">
            <padding>
                <Insets bottom="20" left="34" right="34" top="24" />
            </padding>
            <Label styleClass="screen-title" text="Goals" />
            <Label fx:id="currentGoalLabel" styleClass="screen-kicker" text="2000 cal daily goal" />
        </VBox>
    </top>
    <center>
        <HBox spacing="22">
            <padding>
                <Insets bottom="28" left="34" right="34" top="28" />
            </padding>
            <VBox HBox.hgrow="ALWAYS" spacing="16" styleClass="settings-panel">
                <padding>
                    <Insets bottom="22" left="22" right="22" top="22" />
                </padding>
                <Label styleClass="section-title" text="Manual Calorie Limit" />
                <Label styleClass="card-detail" text="Set a daily target directly when you already know the number." wrapText="true" />
                <TextField fx:id="manualGoalField" promptText="Example: 2100" styleClass="textbox" />
                <Button onAction="#handleSaveManualClick" styleClass="primary-button" text="Save Manual Goal" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="16" styleClass="big-card">
                <padding>
                    <Insets bottom="22" left="22" right="22" top="22" />
                </padding>
                <Label styleClass="section-title" text="Calculate From BMR" />
                <GridPane hgap="12" vgap="12">
                    <Label styleClass="section-label" text="WEIGHT KG" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="weightField" promptText="70" styleClass="textbox" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label styleClass="section-label" text="HEIGHT CM" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="heightField" promptText="170" styleClass="textbox" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label styleClass="section-label" text="AGE" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="ageField" promptText="25" styleClass="textbox" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label styleClass="section-label" text="GENDER" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <ComboBox fx:id="genderComboBox" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    <Label styleClass="section-label" text="ACTIVITY" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <ComboBox fx:id="activityComboBox" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </GridPane>
                <Button onAction="#handleCalculateClick" styleClass="secondary-button" text="Calculate And Save" />
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox spacing="12" styleClass="action-rail">
            <padding>
                <Insets bottom="24" left="34" right="34" top="0" />
            </padding>
            <Button onAction="#handleDashboardClick" styleClass="ghost-button" text="Dashboard" />
            <Button onAction="#handleHistoryClick" styleClass="nav-pill-pink" text="History" />
            <Button onAction="#handleSmartCoachClick" styleClass="nav-pill-green" text="Smart Coach" />
        </HBox>
    </bottom>
</BorderPane>
