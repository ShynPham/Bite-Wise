<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="798.0" prefWidth="1121.0" style="-fx-font-family: 'KG Red Hands';" styleClass="screen-shell" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.InterferenceController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="hero-strip">
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
            </padding>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label styleClass="hero-title" text="BiteWise Food Scanner" />
                <Label styleClass="screen-kicker" text="Upload, detect locally, review, and save your bites." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_LEFT" maxWidth="360.0" prefWidth="360.0" spacing="5.0" styleClass="model-chip-card">
                <Label fx:id="modelStatusLabel" styleClass="section-label" text="Loading best.onnx" />
                <Label fx:id="modelShapeLabel" styleClass="card-detail" text="Private food detection runs on this device." wrapText="true" />
            </VBox>
            <Button onAction="#handleDashboardButtonClick" prefHeight="48.0" prefWidth="150.0" styleClass="primary-button" text="Dashboard" />
            <Button fx:id="settingsButton" onAction="#handleSettingsButtonClick" prefHeight="48.0" prefWidth="150.0" styleClass="ghost-button" text="Settings" />
        </HBox>
    </top>

    <center>
        <StackPane fx:id="imageContainer" styleClass="scanner-stage">
            <BorderPane.margin>
                <Insets bottom="24.0" left="24.0" right="20.0" top="24.0" />
            </BorderPane.margin>
            <ImageView fx:id="imageView" fitHeight="640.0" fitWidth="760.0" preserveRatio="true" smooth="true" StackPane.alignment="CENTER" />
            <Canvas fx:id="overlayCanvas" mouseTransparent="true" StackPane.alignment="CENTER" />
            <VBox fx:id="uploadEmptyState" alignment="CENTER" maxHeight="430.0" maxWidth="585.0" spacing="16.0" styleClass="upload-card">
                <padding>
                    <Insets bottom="38.0" left="46.0" right="46.0" top="38.0" />
                </padding>
                <ImageView fitHeight="112.0" fitWidth="160.0" preserveRatio="true">
                    <Image url="@ui_icons/logo.png" />
                </ImageView>
                <Label styleClass="screen-title" text="Ready for a bite?" />
                <Label alignment="CENTER" styleClass="screen-kicker" text="Use a bright, clear photo for best detection." textAlignment="CENTER" wrapText="true" />
                <HBox alignment="CENTER" spacing="9.0">
                    <Label styleClass="tip-chip" text="Top-down" />
                    <Label styleClass="tip-chip" text="Good light" />
                    <Label styleClass="tip-chip" text="One plate" />
                    <Label styleClass="tip-chip" text="No blur" />
                </HBox>
                <Button fx:id="heroChooseImageButton" onAction="#onChooseImage" prefHeight="50.0" prefWidth="205.0" styleClass="primary-button" text="Upload Image" />
            </VBox>
            <ProgressIndicator fx:id="progressIndicator" maxHeight="96.0" maxWidth="96.0" visible="false" />
        </StackPane>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="390.0" spacing="14.0" styleClass="side-panel">
            <padding>
                <Insets bottom="20.0" left="18.0" right="18.0" top="22.0" />
            </padding>

            <Label styleClass="screen-title" text="Scan Kit" />
            <VBox prefWidth="330.0" spacing="10.0" styleClass="mini-card">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>
                <Label styleClass="section-label" text="ACTIONS" />
                <Button fx:id="chooseImageButton" onAction="#onChooseImage" prefHeight="52.0" prefWidth="298.0" styleClass="primary-button" text="Upload Food Image" />
                <Button fx:id="saveButton" disable="true" onAction="#onSaveDetections" prefHeight="50.0" prefWidth="298.0" styleClass="secondary-button" text="Review Meal" />
                <HBox spacing="10.0">
                    <Button fx:id="clearButton" onAction="#onClearScan" prefHeight="44.0" prefWidth="144.0" styleClass="ghost-button" text="Clear" />
                    <Button fx:id="historyButton" onAction="#onHistoryClick" prefHeight="44.0" prefWidth="144.0" styleClass="secondary-button" text="History" />
                </HBox>
            </VBox>

            <VBox spacing="8.0" styleClass="result-card" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label styleClass="section-title" text="Detections" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="detectionCountLabel" styleClass="metric-number" text="0 found" />
                </HBox>
                <Label fx:id="mealSummaryLabel" styleClass="settings-note" text="Meal estimate: 0 cal" wrapText="true" />
                <TextArea fx:id="detectionResults" editable="false" prefHeight="360.0" prefWidth="306.0" promptText="Detection details will appear here." styleClass="result-area" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="scan-status-bar">
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
            </padding>
            <Label styleClass="section-label" text="STATUS" />
            <Label fx:id="statusLabel" maxWidth="1.7976931348623157E308" styleClass="status-text-large" text="Ready for an image." wrapText="true" HBox.hgrow="ALWAYS" />
        </HBox>
    </bottom>
</BorderPane>
