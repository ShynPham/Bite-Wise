      <Button fx:id="downloadBite" layoutX="191.0" layoutY="331.0" mnemonicParsing="false" onAction="#handleDownload" prefHeight="38.0" prefWidth="168.0" style="-fx-background-color: #8BC081; -fx-border-color: #3F6B36;" text="Download Bite Information" />
   </children>
</AnchorPane>
