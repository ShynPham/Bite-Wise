<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="790.0" prefWidth="520.0" style="-fx-font-family: 'KG Red Hands';" styleClass="screen-shell" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SettingsController">

    <top>
        <VBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets bottom="14.0" left="28.0" right="28.0" top="34.0" />
            </padding>
            <ImageView fitHeight="122.0" fitWidth="172.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@ui_icons/logo.png" />
            </ImageView>
            <Label styleClass="screen-title" text="Settings" />
            <Label alignment="CENTER" styleClass="settings-note" text="Choose your BiteWise adventure." textAlignment="CENTER" wrapText="true" />
        </VBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets bottom="34.0" left="42.0" right="42.0" top="4.0" />
            </padding>
            <VBox alignment="CENTER" spacing="13.0" styleClass="settings-panel">
                <padding>
                    <Insets bottom="24.0" left="26.0" right="26.0" top="24.0" />
                </padding>
                <Button onAction="#handleDashboardClick" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-green" text="Coach Dashboard" />
                <Button onAction="#handleScanScreenClick" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-cream" text="Scan Screen" />
                <Button onAction="#handleMealReviewClick" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-peach" text="Meal Review" />
                <Button onAction="#handleSmartCoachClick" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-green" text="Smart Coach" />
                <Button onAction="#handleTrendsClick" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-peach" text="Trends" />
                <Button onAction="#handleGoalsClick" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-cream" text="Goals" />
                <Button onAction="#handleBiteHistoryClick" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-pink" text="Bite History" />
                <Button onAction="#handleAboutBiteWiseClick" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-green" text="About BiteWise" />
                <Region prefHeight="6.0" />
                <Button onAction="#handleLogOut" prefHeight="50.0" prefWidth="360.0" styleClass="nav-pill-pink" text="Log Out" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
