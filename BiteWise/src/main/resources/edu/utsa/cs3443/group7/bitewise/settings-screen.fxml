<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="1040.0" prefWidth="1440.0" style="-fx-background-color: #D4EAD0;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SettingsController">

    <children>
        <!-- Center all content -->
        <VBox alignment="CENTER" spacing="22.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Logo -->
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@ui_icons/logo.png" />
                </image>
            </ImageView>

            <!-- Title -->
            <Label alignment="CENTER" prefHeight="94.0" prefWidth="280.0" text="Settings" textFill="#53382E">
                <font>
                    <Font name="KG Red Hands" size="64.0" />
                </font>
            </Label>

            <!-- Buttons -->
            <VBox alignment="CENTER" prefHeight="296.0" prefWidth="1440.0" spacing="16.0">

                <!-- Delete a bite -->
                <Button prefHeight="50.0" prefWidth="260.0" style="-fx-background-color: #A8C474; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 25; -fx-border-color: #53382E; -fx-border-width: 2; -fx-border-radius: 25;" text="Delete a bite">
                    <font>
                        <Font name="KG Red Hands" size="18.0" />
                    </font>
                </Button>

                <!-- Change password -->
                <Button prefHeight="50.0" prefWidth="260.0" style="-fx-background-color: #F3AC92; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 25; -fx-border-color: #53382E; -fx-border-width: 2; -fx-border-radius: 25;" text="Change password">
                    <font>
                        <Font name="KG Red Hands" size="18.0" />
                    </font>
                </Button>

                <!-- Recent bite -->
                <Button prefHeight="50.0" prefWidth="260.0" style="-fx-background-color: #FFF0EA; -fx-text-fill: #53382E; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 25; -fx-border-color: #53382E; -fx-border-width: 2; -fx-border-radius: 25;" text="Recent bite">
                    <font>
                        <Font name="KG Red Hands" size="18.0" />
                    </font>
                </Button>

                <!-- Log out -->
                <Button prefHeight="50.0" prefWidth="260.0" style="-fx-background-color: #EEFFEA; -fx-text-fill: #53382E; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 25; -fx-border-color: #53382E; -fx-border-width: 2; -fx-border-radius: 25;" text="Log out">
                    <font>
                        <Font name="KG Red Hands" size="18.0" />
                    </font>
                </Button>

            </VBox>
        </VBox>
    </children>
</AnchorPane>
