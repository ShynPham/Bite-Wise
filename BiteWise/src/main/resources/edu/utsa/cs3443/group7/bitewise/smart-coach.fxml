<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="740.0" prefWidth="1080.0" style="-fx-font-family: 'KG Red Hands';" styleClass="screen-shell" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SmartCoachController">
    <top>
        <VBox spacing="8" styleClass="hero-strip">
            <padding>
                <Insets bottom="20" left="34" right="34" top="24" />
            </padding>
            <Label styleClass="screen-title" text="Smart Coach" />
            <Label fx:id="coachSummaryLabel" styleClass="screen-kicker" text="Offline recommendations from your bites." />
        </VBox>
    </top>
    <center>
        <VBox spacing="22">
            <padding>
                <Insets bottom="28" left="34" right="34" top="28" />
            </padding>
            <GridPane hgap="18" vgap="18">
                <VBox spacing="8" styleClass="coach-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label fx:id="recOneTitle" styleClass="section-title" text="Recommendation" />
                    <Label fx:id="recOneDetail" styleClass="card-detail" text="Details" wrapText="true" />
                </VBox>
                <VBox spacing="8" styleClass="coach-card alt-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label fx:id="recTwoTitle" styleClass="section-title" text="Recommendation" />
                    <Label fx:id="recTwoDetail" styleClass="card-detail" text="Details" wrapText="true" />
                </VBox>
                <VBox spacing="8" styleClass="coach-card warm-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label fx:id="recThreeTitle" styleClass="section-title" text="Recommendation" />
                    <Label fx:id="recThreeDetail" styleClass="card-detail" text="Details" wrapText="true" />
                </VBox>
                <VBox spacing="8" styleClass="coach-card cool-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label fx:id="recFourTitle" styleClass="section-title" text="Recommendation" />
                    <Label fx:id="recFourDetail" styleClass="card-detail" text="Details" wrapText="true" />
                </VBox>
                <VBox spacing="8" styleClass="coach-card pink-card" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                    <Label fx:id="recFiveTitle" styleClass="section-title" text="Recommendation" />
                    <Label fx:id="recFiveDetail" styleClass="card-detail" text="Details" wrapText="true" />
                </VBox>
            </GridPane>
            <HBox spacing="12" styleClass="action-rail">
                <Button onAction="#handleDashboardClick" styleClass="ghost-button" text="Dashboard" />
                <Button onAction="#handleScanClick" styleClass="primary-button" text="Scan" />
                <Button onAction="#handleTrendsClick" styleClass="secondary-button" text="Trends" />
                <Button onAction="#handleGoalsClick" styleClass="nav-pill-green" text="Goals" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
